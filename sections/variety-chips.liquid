{%- assign c = section.settings.collection | default: collections.all -%}
<section class="sec" style="padding-bottom:8px" {{ section.shopify_attributes }}>
  <div class="container">
    {%- if section.settings.heading != blank -%}<div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>{%- endif -%}
    <div class="chips">
      {%- for p in c.products limit: 16 -%}
        <a class="chip" href="{{ p.url }}">
          <div class="chip__ph">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', width: 88, height: 88, alt: '' }}{%- endif -%}</div>
          <b>{{ p.title }}</b>
        </a>
      {%- else -%}
        <p class="muted">{{ 'collection.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Variety shortcuts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "اختر صنفك المفضّل" },
    { "type": "collection", "id": "collection", "label": "Collection (default: all products)" }
  ],
  "presets": [{ "name": "Variety shortcuts" }]
}
{% endschema %}
