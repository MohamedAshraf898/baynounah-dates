{%- if section.blocks.size > 0 -%}
<div class="announce" role="region" aria-label="{{ section.settings.label | escape }}" {{ section.shopify_attributes }}>
  <div class="announce__track">
    {%- for block in section.blocks -%}
      <div class="announce__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "announce-section",
  "settings": [{ "type": "text", "id": "label", "label": "Accessible label", "default": "عروض" }],
  "blocks": [{ "type": "message", "name": "Message", "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "شحن مجاني للطلبات فوق <strong>200 د.إ</strong>" },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "max_blocks": 6
}
{% endschema %}
