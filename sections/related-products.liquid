<section class="sec" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="rail">
      {%- assign n = 0 -%}
      {%- for p in collections.all.products -%}
        {%- if p.id != product.id and n < 8 -%}{% render 'product-card', product: p %}{%- assign n = n | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Other varieties",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "جرّب أصنافاً أخرى" }]
}
{% endschema %}
