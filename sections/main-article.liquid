<article class="container page">
  <h1>{{ article.title }}</h1>
  <p class="muted" style="margin-bottom:16px">{{ article.published_at | date: format: 'date' }}</p>
  {%- if article.image -%}<div style="border-radius:18px;overflow:hidden;margin-bottom:20px">{{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: article.title }}</div>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</article>
{% schema %}{ "name": "Article" }{% endschema %}
