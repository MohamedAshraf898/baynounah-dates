<section class="sec sec--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="occ">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width: 768px) 40vw, 100vw', alt: '' }}
          {%- elsif block.settings.fallback != blank -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="1000" height="1000">
          {%- endif -%}
          <div><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Occasions",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "لكل مناسبة، تمور من بينونة" }],
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Theme image file (used when no image is picked)" },
    { "type": "text", "id": "title", "label": "Title", "default": "للعزائم والضيافة" },
    { "type": "text", "id": "text", "label": "Text", "default": "تشكيلة تمور تناسب تجمعات الأهل والأصدقاء." },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "max_blocks": 3,
  "presets": [{ "name": "Occasions" }]
}
{% endschema %}
