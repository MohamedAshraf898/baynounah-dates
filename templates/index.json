        "b1": {
          "type": "qa",
          "settings": {
            "q": "ما أحجام العلب المتوفرة؟",
            "a": "<p>كل صنف متوفر في علبتين: العلبة الصغيرة بوزن 500 غرام تقريباً، والعلبة الكبيرة بوزن 950 غرام تقريباً.</p>"
          }
        },
        "b2": {
          "type": "qa",
          "settings": {
            "q": "من أين تأتي تمور بينونة؟",
            "a": "<p>من نخيل مزارعنا في الإمارات، ونحرص على أن يصل طعمها الأصيل إلى بيوتكم ومجالسكم.</p>"
          }
        },
        "b3": {
          "type": "qa",
          "settings": {
            "q": "هل يمكن إضافة رسالة إهداء؟",
            "a": "<p>نعم، يمكنك كتابة رسالة إهداء مجانية من صفحة المنتج أو من السلة قبل إتمام الطلب.</p>"
          }
        },
        "b4": {
          "type": "qa",
          "settings": {
            "q": "كيف أحفظ التمور؟",
            "a": "<p>احفظها في مكان بارد وجاف بعيداً عن أشعة الشمس، ويُفضّل حفظها في الثلاجة بعد فتح العلبة.</p>"
          }
        },
        "b5": {
          "type": "qa",
          "settings": {
            "q": "هل توفرون هدايا للشركات؟",
            "a": "<p>نعم، نوفّر تشكيلة من التمور الإماراتية وعلب التمور المناسبة لهدايا الشركات والعملاء. تواصل معنا لمعرفة التفاصيل.</p>"
          }
        }
