<div class="container page">
  <h1>{{ 'customer.activate' | t }}</h1>
  {%- form 'activate_customer_password', class: 'form' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="a-pass">{{ 'customer.password' | t }}</label><input class="field" id="a-pass" type="password" name="customer[password]" autocomplete="new-password">
    <label for="a-pass2">{{ 'customer.password' | t }}</label><input class="field" id="a-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password">
    <button class="btn btn--primary" type="submit">{{ 'customer.activate' | t }}</button>
  {%- endform -%}
</div>
