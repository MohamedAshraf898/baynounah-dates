{%- liquid
  assign link = section.settings.link
  if link == blank and settings.whatsapp != blank
    assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-'
    assign msg = section.settings.wa_message | url_encode
    assign link = 'https://wa.me/' | append: wa | append: '?text=' | append: msg
  endif
-%}
<section class="sec sec--tight" id="corporate" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="corp">
      <div class="pattern"></div>
      <div style="position:relative">
        <span class="eyebrow" style="color:var(--cream)"><img src="{{ 'palm-cream.png' | asset_url }}" alt="" width="18" height="16">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        <ul>{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}</ul>
      </div>
      <div style="position:relative">
        {%- if link != blank -%}<a class="btn btn--gold btn--block" href="{{ link }}" {% if link contains 'wa.me' %}target="_blank" rel="noopener"{% endif %}>{% if link contains 'wa.me' %}{% render 'icon', name: 'whatsapp' %}{% endif %} {{ section.settings.button }}</a>{%- endif -%}
        {%- if section.settings.note != blank -%}<small>{{ section.settings.note }}</small>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Corporate gifts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "بينونة للأعمال" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "هدايا للشركات والمناسبات تليق بكم" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>لأن كل هدية تعبّر عن تقديركم، نقدّم لكم من بينونة تشكيلة من التمور الإماراتية تناسب هدايا الشركات والعملاء ومختلف المناسبات. اختاروا من أصنافنا المتنوعة وعلب التمور التي تناسب احتياجاتكم.</p>" },
    { "type": "text", "id": "button", "label": "Button", "default": "تواصل معنا لمعرفة التفاصيل" },
    { "type": "url", "id": "link", "label": "Button link (empty = WhatsApp from theme settings)" },
    { "type": "text", "id": "wa_message", "label": "WhatsApp prefilled message", "default": "مرحباً، أرغب بالاستفسار عن هدايا الشركات من تمور بينونة" },
    { "type": "text", "id": "note", "label": "Small note under button" }
  ],
  "blocks": [{ "type": "point", "name": "Point", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "تشكيلة متنوعة من التمور الإماراتية" }] }],
  "max_blocks": 5,
  "presets": [{ "name": "Corporate gifts" }]
}
{% endschema %}
