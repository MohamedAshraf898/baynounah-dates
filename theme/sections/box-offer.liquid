<section class="sec sec--tight" id="boxes" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="offer">
      <div class="pattern"></div>
      <div class="offer__txt">
        <span class="eyebrow" style="color:var(--cream)"><img src="{{ 'palm-cream.png' | asset_url }}" alt="" width="18" height="16">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <div class="steps">
          {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}
        </div>
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="btn btn--gold">{{ section.settings.button }}</a>
      </div>
      <div class="offer__img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 768px) 50vw, 100vw' }}
        {%- else -%}
          <img src="{{ 'offer.webp' | asset_url }}" alt="{{ section.settings.heading | strip_html | escape }}" width="1200" height="1200" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Date box offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "علب التمور" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "علبة تمور تليق بضيافتك ومناسباتك" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "سواء كنت تستقبل ضيوفك أو تبحث عن هدية لشخص عزيز، اختر من تمور بينونة ما يناسب مناسبتك ويضيف لها لمسة مميزة." },
    { "type": "text", "id": "button", "label": "Button", "default": "اكتشف علب التمور" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [{ "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "اختر الأصناف" }] }],
  "max_blocks": 4,
  "presets": [{ "name": "Date box offer" }]
}
{% endschema %}
