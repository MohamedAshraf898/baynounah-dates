{%- if section.blocks.size > 0 -%}
<section class="sec sec--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <div class="review" {{ block.shopify_attributes }}>
          <span class="stars" aria-label="{{ block.settings.rating }}/5">{% for i in (1..block.settings.rating) %}★{% endfor %}</span>
          <p>{{ block.settings.quote }}</p>
          <b>{{ block.settings.name }}</b> {% if block.settings.city != blank %}<small>· {{ block.settings.city }}</small>{% endif %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Customer reviews",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "ماذا يقول عملاؤنا" }],
  "blocks": [{ "type": "review", "name": "Review", "settings": [
    { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "quote", "label": "Review text (real customer reviews only)" },
    { "type": "text", "id": "name", "label": "Customer name" },
    { "type": "text", "id": "city", "label": "City" }
  ]}],
  "max_blocks": 9,
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
