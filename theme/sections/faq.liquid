<section class="sec sec--tight faq" id="faq" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:780px">
    <div class="sec-head"><div><h2>{{ section.settings.heading }}</h2></div></div>
    {%- for block in section.blocks -%}
      <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="rte">{{ block.settings.a }}</div></details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "الأسئلة الشائعة" }],
  "blocks": [{ "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "q", "label": "Question", "default": "ما أحجام العلب المتوفرة؟" },
    { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>العلبة الصغيرة بوزن 500 غرام تقريباً، والعلبة الكبيرة بوزن 950 غرام تقريباً.</p>" }
  ]}],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
