<section class="sec sec--tight" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="why-head">
      <span class="eyebrow"><img src="{{ 'palm-green.png' | asset_url }}" alt="" width="18" height="16">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="why">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><div class="ic">{% render 'icon', name: block.settings.icon %}</div><b>{{ block.settings.title }}</b><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Why Baynounah",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "لماذا بينونة؟" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "لأن التمور الطيبة تبدأ من أرض طيبة" }
  ],
  "blocks": [{ "type": "item", "name": "Item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "farm", "options": [
      { "value": "farm", "label": "Palm / farm" }, { "value": "grid", "label": "Variety" }, { "value": "coffee", "label": "Hospitality" },
      { "value": "gift", "label": "Gift" }, { "value": "truck", "label": "Delivery" }, { "value": "shield", "label": "Quality" }, { "value": "building", "label": "Corporate" } ] },
    { "type": "text", "id": "title", "label": "Title", "default": "من مزارعنا الإماراتية" },
    { "type": "text", "id": "text", "label": "Text", "default": "نقدّم لكم تموراً من نخيل مزارعنا في الإمارات." }
  ]}],
  "max_blocks": 4,
  "presets": [{ "name": "Why Baynounah" }]
}
{% endschema %}
