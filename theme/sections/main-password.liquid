<div class="container page" style="text-align:center;padding-top:60px">
  <img src="{{ 'logo-green.png' | asset_url }}" alt="{{ shop.name }}" width="140" height="131" style="margin:0 auto 20px">
  <h1>{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted" style="margin-bottom:20px">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'form', style: 'margin:auto' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <input class="field" type="password" name="password" autocomplete="current-password" aria-label="{{ 'customer.password' | t }}" placeholder="{{ 'customer.password' | t }}">
    <button class="btn btn--primary" type="submit">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</div>
{% schema %}{ "name": "Password page" }{% endschema %}
